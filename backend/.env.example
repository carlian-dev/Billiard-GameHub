# Backend env example — copy to backend/.env for local runs. Never commit real secrets.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017
DB_NAME=gamehub
AUTH_SECRET=change-me-to-a-long-random-secret
FRONTEND_URL=http://localhost:5173
# Controlled ADMIN bootstrap (`bun run --cwd backend seed:admin`). Optional:
# leave SEED_ADMIN_PASSWORD unset to generate and print a random password once.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-on-first-seed
SEED_ADMIN_DISPLAY_NAME=System Administrator
